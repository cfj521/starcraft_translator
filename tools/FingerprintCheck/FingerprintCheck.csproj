<Project Sdk="Microsoft.NET.Sdk">

  <!-- 非 16:9 截图的指纹核验：把出厂 1080p 区域缩放到截图分辨率，算实时块均值指纹，
       跟出厂指纹逐块比命中，验证「更高→拉伸铺满→按轴等比」是否成立。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>ScrTranslator.Tools.FingerprintCheck</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ScrTranslator.Core\ScrTranslator.Core.csproj" />
  </ItemGroup>

</Project>
