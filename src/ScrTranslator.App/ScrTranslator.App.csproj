<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ScrTranslator.Core\ScrTranslator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="scene-refs.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Update="layout-presets.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <Content Include="app.ico"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\docs\GLOSSARY.md" Link="GLOSSARY.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- 内置字体：Kostar = 原版 SC:R 游戏字体（拉丁复刻原字体 + 全套谚文，无中文）。
       随构建拷贝到输出目录，悬浮层运行时按文件路径构造 FontFamily（见 OverlayWindow.ResolveFontFamily）。
       为何不用 pack URI 内嵌：实测 WPF 对 .g.resources 里的 .ttf 取得到流却不加载为字体（回落 Arial），
       文件路径方式则正常，故走 Content 拷贝 + 文件 URI。 -->
  <ItemGroup>
    <Content Include="..\..\resources\Kostar.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>0.1.1</Version>
    <Company>SC:R Translator</Company>
    <Product>SC:R Translator</Product>
    <Copyright>MIT License</Copyright>
  </PropertyGroup>

</Project>
