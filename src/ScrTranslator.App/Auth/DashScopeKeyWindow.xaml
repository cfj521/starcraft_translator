<Window x:Class="ScrTranslator.App.Auth.DashScopeKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置阿里云 DashScope Key"
        Width="420" Height="150"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    <StackPanel Margin="16">
        <TextBlock Text="阿里云 DashScope API Key：" Margin="0,0,0,8"/>
        <PasswordBox x:Name="KeyBox" Height="26"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="确定" Width="80" Margin="0,0,8,0" Click="OnOk"/>
            <Button x:Name="CancelButton" Content="取消" Width="80" Click="OnCancel"/>
        </StackPanel>
    </StackPanel>
</Window>
