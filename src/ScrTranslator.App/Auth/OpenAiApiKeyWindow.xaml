<Window x:Class="ScrTranslator.App.Auth.OpenAiApiKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 OpenAI API Key"
        Width="420" Height="195"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="OpenAI API Key：" Margin="0,0,0,8"/>
        <PasswordBox x:Name="KeyBox" Height="26"/>
        <TextBlock Margin="0,10,0,0">
            <Hyperlink NavigateUri="https://platform.openai.com/api-keys" RequestNavigate="OnKeyLinkNavigate">到 OpenAI 平台获取 API Key</Hyperlink>
        </TextBlock>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="确定" Width="80" Margin="0,0,8,0" Click="OnOk"/>
            <Button x:Name="CancelButton" Content="取消" Width="80" Click="OnCancel"/>
        </StackPanel>
    </StackPanel>
</Window>
