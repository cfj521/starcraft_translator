<Window x:Class="ScrTranslator.App.Auth.TencentKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置腾讯云机器翻译密钥"
        Width="460" Height="210"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    <StackPanel Margin="16">
        <TextBlock Text="腾讯云 SecretId（TC3-HMAC-SHA256 签名用，免费 500 万字符/月）：" Margin="0,0,0,4"/>
        <TextBox x:Name="SecretIdBox" Height="26" Margin="0,0,0,10"/>
        <TextBlock Text="腾讯云 SecretKey：" Margin="0,0,0,4"/>
        <PasswordBox x:Name="SecretKeyBox" Height="26"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="确定" Width="80" Margin="0,0,8,0" Click="OnOk"/>
            <Button x:Name="CancelButton" Content="取消" Width="80" Click="OnCancel"/>
        </StackPanel>
    </StackPanel>
</Window>
