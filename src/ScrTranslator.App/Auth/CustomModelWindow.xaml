<Window x:Class="ScrTranslator.App.Auth.CustomModelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配置自定义模型（OpenAI 兼容模式）"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap" Foreground="DarkOrange" Margin="0,0,0,12"
                   Text="ⓘ 请使用 OpenAI 兼容模式（POST {URL}/chat/completions）。适用于自建推理服务（vLLM / Ollama / LM Studio 等）或第三方 OpenAI 兼容代理。URL 请填到 /v1 为止（末尾不带 /chat/completions）。"/>
        <TextBlock Text="服务端点（Base URL）：" Margin="0,0,0,4"/>
        <TextBox x:Name="UrlBox" Height="28" VerticalContentAlignment="Center"/>
        <TextBlock Text="模型 ID：" Margin="0,12,0,4"/>
        <TextBox x:Name="ModelBox" Height="28" VerticalContentAlignment="Center"/>
        <TextBlock Text="API Key：" Margin="0,12,0,4"/>
        <PasswordBox x:Name="KeyBox" Height="28"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="确定" Width="80" Margin="0,0,8,0" Click="OnOk" IsDefault="True"/>
            <Button x:Name="CancelButton" Content="取消" Width="80" Click="OnCancel" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
