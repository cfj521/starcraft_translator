<Window x:Class="ScrTranslator.App.DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScrTranslator Debug"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False"
        IsHitTestVisible="False"
        WindowStartupLocation="Manual"
        Left="0" Top="0">
    <Border Background="#CC000000" CornerRadius="0" BorderBrush="#60FFFFFF" BorderThickness="1" Padding="6,4">
        <TextBlock x:Name="DebugText" Foreground="#FF7CFF9B" FontFamily="Consolas, Cascadia Mono, Microsoft YaHei"
                   FontSize="15" LineHeight="19" TextWrapping="Wrap" Text="调试面板（Ctrl+F6 复制）"/>
    </Border>
</Window>
