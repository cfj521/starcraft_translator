<Window x:Class="ScrTranslator.App.DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScrTranslator Debug"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="10" Top="10">
    <Border Background="#CC000000" CornerRadius="6" BorderBrush="#60FFFFFF" BorderThickness="1" Padding="8,6">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                <TextBlock Text="DEBUG" Foreground="#FF8FC7FF" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button x:Name="CopyButton" Content="复制" Padding="10,1" Click="OnCopyClick"/>
            </StackPanel>
            <TextBlock x:Name="DebugText" Foreground="#FF7CFF9B" FontFamily="Consolas, Cascadia Mono, Microsoft YaHei"
                       FontSize="15" LineHeight="19" TextWrapping="Wrap" Text="调试面板"/>
        </DockPanel>
    </Border>
</Window>
