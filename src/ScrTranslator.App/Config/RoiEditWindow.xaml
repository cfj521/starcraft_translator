<Window x:Class="ScrTranslator.App.Config.RoiEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑区域" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="归属" VerticalAlignment="Center"/>
        <TextBlock x:Name="OwnerText" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                   Text="—" VerticalAlignment="Center" Foreground="Gray"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="名称" VerticalAlignment="Center"/>
        <TextBox x:Name="NameBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="类型" VerticalAlignment="Center"/>
        <ComboBox x:Name="TypeCombo" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="左上角" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
            <TextBlock Text="X" VerticalAlignment="Center"/>
            <TextBox x:Name="XBox" Width="70" Margin="4,0,8,0"/>
            <TextBlock Text="Y" VerticalAlignment="Center"/>
            <TextBox x:Name="YBox" Width="70" Margin="4,0,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="8" Grid.Column="0" Text="尺寸" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal">
            <TextBlock Text="宽" VerticalAlignment="Center"/>
            <TextBox x:Name="WBox" Width="70" Margin="4,0,8,0"/>
            <TextBlock Text="高" VerticalAlignment="Center"/>
            <TextBox x:Name="HBox" Width="70" Margin="4,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock x:Name="ErrorText" Foreground="Red" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="确定" Width="70" Margin="0,0,8,0" IsDefault="True" Click="OnOk"/>
            <Button Content="取消" Width="70" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
