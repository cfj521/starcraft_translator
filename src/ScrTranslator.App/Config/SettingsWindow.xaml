<Window x:Class="ScrTranslator.App.Config.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SC:R Translator — 配置"
        Width="820" Height="600"
        MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="RowLabel">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Width" Value="120"/>
        </Style>
        <Style TargetType="StackPanel" x:Key="Row">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="ApplyButton" Content="应用" Width="80" Margin="0,0,8,0" Click="OnApplyClick"/>
            <Button x:Name="OkButton" Content="确定" Width="80" Margin="0,0,8,0" Click="OnOkClick" IsDefault="True"/>
            <Button x:Name="CancelButton" Content="取消" Width="80" Click="OnCancelClick" IsCancel="True"/>
        </StackPanel>

        <TabControl TabStripPlacement="Left">

            <!-- ══════════════════ 常规 ══════════════════ -->
            <TabItem Header="常规">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Header="游戏窗口">
                            <StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="目标进程" Style="{StaticResource RowLabel}"/>
                                    <TextBox x:Name="TargetProcessBox" Width="180"/>
                                    <Button x:Name="RedetectButton" Content="重新检测" Margin="8,0,0,0" Click="OnRedetectClick"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="当前状态" Style="{StaticResource RowLabel}"/>
                                    <TextBlock x:Name="StatusText" Text="○ 未检测" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="⚠ 提示：请以“窗口化/无边框”模式运行游戏，独占全屏无法悬浮。"
                                           Foreground="DarkOrange" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="启动">
                            <StackPanel>
                                <CheckBox x:Name="AutoStartCheck" Content="开机自启（保存时写 HKCU Run 键；开发期指向 Debug exe）" Margin="0,2,0,2"/>
                                <CheckBox x:Name="StartMinimizedCheck" Content="启动后最小化到托盘（程序无主窗口，此行为恒为真）" IsEnabled="False" Margin="0,2,0,2"/>
                                <CheckBox x:Name="AutoTranslateCheck" Content="启动游戏时自动开启翻译（程序启动即开启，等待游戏窗口出现自动续译）" Margin="0,2,0,2"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="调试">
                            <StackPanel>
                                <CheckBox x:Name="DebugModeCheck" Content="DEBUG 模式：左上角显示诊断面板（场景识别/帧/ROI/翻译状态）（F8）" Margin="0,2,0,2"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="语言">
                            <StackPanel>
                                <TextBlock Text="界面语言：简体中文（固定）" Margin="0,2,0,2"/>
                                <TextBlock Text="源语言 → 目标：韩文 → 简体中文（固定）" Margin="0,2,0,2"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════════ 翻译 ══════════════════ -->
            <TabItem Header="翻译">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Header="Provider 池（拖动调整顺序；从上到下取第一个「启用且可用」的，不可用/额度耗尽/翻译失败就跳下一个）">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,6"
                                           Text="默认顺序＝先免费机器翻译、后 LLM。勾选＝启用，拖动手柄＝调整优先级；某行不可用或额度用尽时自动跳到下一行。"/>
                                <ListView x:Name="ProviderListView" Height="172" Margin="0,0,0,6"
                                          AllowDrop="True" DragOver="OnProviderListDragOver" Drop="OnProviderListDrop"
                                          MouseLeftButtonDown="OnProviderListMouseDown">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="⠿" Foreground="Gray" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <Border CornerRadius="3" Background="#F0F0F0" Padding="6,1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Kind}" Foreground="Gray"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="#B8860B" VerticalAlignment="Center" Margin="8,0,8,0"/>
                                                <Button Grid.Column="3" Content="配置…" Width="64" Tag="{Binding Id}" Click="OnProviderConfigureClick"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <StackPanel Style="{StaticResource Row}">
                                    <Button x:Name="ResetProviderOrderButton" Content="恢复默认顺序" Width="120" Click="OnResetProviderOrderClick"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="DashScope 模型" Style="{StaticResource RowLabel}"/>
                                    <TextBox x:Name="DashScopeModelBox" Width="180"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="ChatGPT 模型" Style="{StaticResource RowLabel}"/>
                                    <TextBox x:Name="ChatGptModelBox" Width="180"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="内容范围">
                            <StackPanel>
                                <CheckBox x:Name="TranslateChatCheck" Content="翻译聊天" Margin="0,2,0,2"/>
                                <CheckBox x:Name="TranslateRoomNameCheck" Content="翻译房间名" Margin="0,2,0,2"/>
                                <CheckBox x:Name="TranslateMapInfoCheck" Content="翻译地图信息" Margin="0,2,0,2"/>
                                <CheckBox x:Name="TranslatePlayerIdCheck" Content="翻译玩家 ID（默认关）" Margin="0,2,0,2"/>
                                <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,4,0,0"
                                           Text="ⓘ 玩家 ID 多为专有名词，通常不翻译。开启后&quot;房间名列表&quot;里的 ID 列也会被翻译。"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="质量与省流">
                            <StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <CheckBox x:Name="GlossaryEnabledCheck" Content="启用术语表（星际黑话，始终生效）" IsChecked="True" IsEnabled="False" VerticalAlignment="Center"/>
                                    <Button x:Name="EditGlossaryButton" Content="编辑术语表…" Margin="12,0,0,0" Click="OnEditGlossaryClick"/>
                                </StackPanel>
                                <CheckBox x:Name="CacheEnabledCheck" Content="启用翻译缓存（进程内 LRU，容量固定，无 TTL）" IsChecked="True" IsEnabled="False" Margin="0,4,0,4"/>
                                <CheckBox Content="LLM 节流（防刷屏）— 后续" IsEnabled="False" Margin="0,4,0,4"/>
                                <CheckBox Content="保留上下文供 LLM 参考 — 后续" IsEnabled="False" Margin="0,4,0,4"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════════ OCR ══════════════════ -->
            <TabItem Header="OCR">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Header="识别引擎">
                            <TextBlock Text="PaddleOCR（韩文 mobile 模型，随包分发，无需系统语言包）" Margin="4"/>
                        </GroupBox>
                        <GroupBox Header="轮询节拍（应用后即时生效；100–5000ms）">
                            <StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="场景检测" Style="{StaticResource RowLabel}"/>
                                    <TextBlock Text="每" VerticalAlignment="Center"/>
                                    <TextBox x:Name="SceneDetectPollBox" Width="60" Margin="4,0,4,0"/>
                                    <TextBlock Text="ms 识别一次（只比几块静态区，很快；默认 200）" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="翻译" Style="{StaticResource RowLabel}"/>
                                    <TextBlock Text="每" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TranslatePollBox" Width="60" Margin="4,0,4,0"/>
                                    <TextBlock Text="ms 跑一轮 OCR+翻译（默认 500）" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                        <TextBlock Text="预处理与变化检测：由 PaddleOCR 内置管线与精确文本比对处理，实测无需额外开关（原占位设置已移除）。"
                                   Foreground="Gray" Margin="4,8,4,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════════ 区域 ══════════════════ -->
            <TabItem Header="区域">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RegionHintText" Text="尚未加载" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="EnterCalibrationButton" Content="进入校准 (F10)" Click="OnEnterCalibrationClick"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="已定义区域（坐标为像素坐标）：" FontWeight="Bold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="EditRoiButton" Content="编辑选中" Click="OnEditRoiClick"/>
                                <Button x:Name="DeleteRoiButton" Content="删除选中" Margin="8,0,0,0" Click="OnDeleteRoiClick"/>
                            </StackPanel>
                        </Grid>
                        <ListView x:Name="RoiListView" Height="200" Margin="0,0,0,4"
                                  MouseDoubleClick="OnRoiListDoubleClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="场景" Width="86" DisplayMemberBinding="{Binding Scene}"/>
                                    <GridViewColumn Header="分辨率" Width="90" DisplayMemberBinding="{Binding Resolution}"/>
                                    <GridViewColumn Header="名称" Width="150" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="类型" Width="86" DisplayMemberBinding="{Binding Type}"/>
                                    <GridViewColumn Header="左上角 X,Y" Width="94" DisplayMemberBinding="{Binding TopLeft}"/>
                                    <GridViewColumn Header="宽 × 高" Width="94" DisplayMemberBinding="{Binding Size}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,10"
                                   Text="ⓘ 双击或选中后点&quot;编辑选中&quot;即可改坐标；预设的修改写入 %APPDATA%\ScrTranslator\layout-overrides.json，删掉该文件即恢复出厂值。拖框请用&quot;进入校准&quot;。"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="房间列表列区域：" FontWeight="Bold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="EditColumnButton" Content="编辑选中" Click="OnEditColumnClick"/>
                                <Button x:Name="DeleteColumnButton" Content="删除选中" Margin="8,0,0,0" Click="OnDeleteColumnClick"/>
                            </StackPanel>
                        </Grid>
                        <ListView x:Name="ColumnsListView" Height="140" MouseDoubleClick="OnColumnListDoubleClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="列名" Width="150" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="左上角 X,Y" Width="110" DisplayMemberBinding="{Binding TopLeft}"/>
                                    <GridViewColumn Header="宽 × 高" Width="110" DisplayMemberBinding="{Binding Size}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,8,0,0"
                                   Text="ⓘ 每列的 Y 与高跟随所属列表框，只有 X 与宽可改；&quot;翻译玩家 ID&quot;开关仍由「翻译」页决定。"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════════ 热键 ══════════════════ -->
            <TabItem Header="热键">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <ListView x:Name="HotkeyListView" Height="220">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="功能" Width="220" DisplayMemberBinding="{Binding Function}"/>
                                    <GridViewColumn Header="当前热键" Width="140" DisplayMemberBinding="{Binding Current}"/>
                                    <GridViewColumn Header="操作" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="修改" Width="70" Tag="{Binding Key}" Click="OnRebindHotkeyClick"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <Button x:Name="ResetHotkeysButton" Content="恢复默认热键" Width="120" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnResetHotkeysClick"/>
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,8,0,0"
                                   Text="点「修改」后按下新组合键即可录制（Esc 取消）；冲突会提示并放弃，成功则立即生效并保存。"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════════ 外观 ══════════════════ -->
            <TabItem Header="外观">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Header="悬浮层">
                            <StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="字体" Style="{StaticResource RowLabel}"/>
                                    <ComboBox x:Name="FontFamilyBox" Width="160" IsEditable="True">
                                        <ComboBoxItem Content="Microsoft YaHei"/>
                                        <ComboBoxItem Content="Microsoft YaHei UI"/>
                                        <ComboBoxItem Content="SimHei"/>
                                        <ComboBoxItem Content="SimSun"/>
                                    </ComboBox>
                                    <TextBlock Text="字号" Style="{StaticResource RowLabel}" Width="50" Margin="16,0,8,0"/>
                                    <TextBox x:Name="FontSizeBox" Width="50"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="不透明度" Style="{StaticResource RowLabel}"/>
                                    <Slider x:Name="OpacitySlider" Width="200" Minimum="0" Maximum="1" ValueChanged="OnOpacityChanged"/>
                                    <TextBlock x:Name="OpacityValueText" Text="80%" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="文字底衬" Style="{StaticResource RowLabel}"/>
                                    <Slider x:Name="BackplateSlider" Width="200" Minimum="0" Maximum="1" ValueChanged="OnBackplateChanged"/>
                                    <TextBlock x:Name="BackplateValueText" Text="80%" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="（黑底不透明度，0=不显示底衬；压不住浅色画面时调高）" Foreground="Gray" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="显示模式" Style="{StaticResource RowLabel}"/>
                                    <RadioButton x:Name="OnlyTranslationRadio" GroupName="DisplayMode" Content="仅译文" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                    <RadioButton x:Name="BothRadio" GroupName="DisplayMode" Content="原文+译文双行" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="临时态(快引擎)样式" Style="{StaticResource RowLabel}" Width="140"/>
                                    <TextBlock Text="灰色/半斜体 0.65 透明（只读，改色留后续）" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="最终态(精译)样式" Style="{StaticResource RowLabel}" Width="140"/>
                                    <TextBlock Text="正常白色（只读）" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════════ 关于 ══════════════════ -->
            <TabItem Header="关于">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock x:Name="VersionText" Text="版本 —" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                        <TextBlock Text="许可：内部项目，未开源" Margin="0,0,0,8"/>
                        <TextBlock Text="第三方组件：" FontWeight="Bold" Margin="0,8,0,4"/>
                        <TextBlock TextWrapping="Wrap"
                                   Text="H.NotifyIcon.Wpf（系统托盘）、RapidOcrNet + PaddleOCR 韩文 mobile 模型（OCR）、SkiaSharp（图像处理）、Microsoft.Extensions.Hosting（DI 组合根）、System.Security.Cryptography.ProtectedData（DPAPI）、CsWinRT / Windows.Graphics.Capture（屏幕捕获）。"/>
                        <TextBlock Text="使用须知：" FontWeight="Bold" Margin="0,12,0,4"/>
                        <TextBlock TextWrapping="Wrap"
                                   Text="• 请以「窗口化/无边框」模式运行《星际争霸：重制版》，独占全屏会遮挡悬浮窗，悬浮窗也不可交互（点击穿透）。&#10;• 本软件纯读屏：仅截取屏幕画面做 OCR 识别 + 翻译显示，不注入游戏进程、不修改游戏文件、不读取游戏内存。&#10;• 任何第三方叠加层工具理论上都存在被反作弊/官方规则误判的风险，请自行评估后使用；作者不对因使用本软件导致的任何账号处罚负责。"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
