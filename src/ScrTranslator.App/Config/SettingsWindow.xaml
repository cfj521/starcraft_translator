<Window x:Class="ScrTranslator.App.Config.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SC:R Translator — 配置"
        Width="850" Height="720"
        MinWidth="680" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="RowLabel">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Width" Value="120"/>
        </Style>
        <Style TargetType="StackPanel" x:Key="Row">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
        </Style>
        <!-- provider 池行模板：本地/外部两个列表共用。⠿=拖拽柄，名称，（仅 LLM 行）模型名输入框，MT/LLM 徽标，状态，配置按钮 -->
        <DataTemplate x:Key="ProviderRowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⠿" Foreground="Gray" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <!-- 模型名输入框：仅 LLM 行（ChatGPT/DashScope，ShowModel=True）显示，放在名称之后。
                         圆角 Border 包住 + TextBox 无边框透明（白底由 Border 提供）。不设固定高度（全局 Fluent 样式会给 TextBox 加 Padding=6,3，固定 Height 会把文字裁掉只剩顶部） -->
                    <Border VerticalAlignment="Center" Margin="0,0,8,0" Background="White" BorderBrush="#C0C0C0" BorderThickness="1" CornerRadius="4" Padding="4,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowModel}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" Width="100" Padding="1,1" BorderThickness="0" Background="Transparent" VerticalAlignment="Center"/>
                    </Border>
                    <Border CornerRadius="3" Background="#F0F0F0" Padding="6,1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Kind}" Foreground="Gray"/>
                    </Border>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="#B8860B" VerticalAlignment="Center" Margin="8,0,8,0"/>
                <!-- 登录账号 tooltip：仅 ChatGPT「订阅登录」按钮显示，且已登录后才出现（StatusTooltip 未登录时为空=不显示） -->
                <Button Grid.Column="3" Content="{Binding ConfigButtonText}" VerticalAlignment="Stretch" Tag="{Binding Id}" ToolTip="{Binding StatusTooltip}" Click="OnProviderConfigureClick"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <!-- 恢复默认＝按页操作，左对齐且自适应宽度（装得下 9 个字）；确定/取消＝对话框主操作，靠右 -->
            <Button x:Name="RestoreDefaultsButton" DockPanel.Dock="Left" Content="恢复当前页默认值" Margin="0,0,8,0" Click="OnRestoreDefaultsClick"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" Content="确定" Width="80" Margin="0,0,8,0" Click="OnOkClick" IsDefault="True"/>
                <Button x:Name="CancelButton" Content="取消" Width="80" Click="OnCancelClick" IsCancel="True"/>
            </StackPanel>
        </DockPanel>

        <TabControl x:Name="PagesTab" TabStripPlacement="Left" SelectionChanged="OnTabSelectionChanged">

            <!-- ══════════════════ 常规 ══════════════════ -->
            <TabItem Header="常规">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Header="游戏窗口">
                            <StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="目标进程" Style="{StaticResource RowLabel}"/>
                                    <TextBox x:Name="TargetProcessBox" Width="180"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="当前状态" Style="{StaticResource RowLabel}"/>
                                    <TextBlock x:Name="StatusText" Text="○ 未检测" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="⚠ 提示：请以“窗口化/无边框”模式运行游戏，独占全屏无法悬浮。"
                                           Foreground="DarkOrange" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="启动">
                            <StackPanel>
                                <CheckBox x:Name="AutoStartCheck" Content="开机自启" Margin="0,2,0,2"/>
                                <CheckBox x:Name="AutoTranslateCheck" Content="启动程序自动开始翻译" Margin="0,2,0,2"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="语言">
                            <StackPanel>
                                <!-- 界面语言：下拉框（目前仅简体中文一项，预留多语言扩展） -->
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="界面语言" Style="{StaticResource RowLabel}"/>
                                    <ComboBox x:Name="UiLanguageBox" Width="120">
                                        <ComboBoxItem Content="简体中文" IsSelected="True"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="翻译" Style="{StaticResource RowLabel}"/>
                                    <TextBlock Text="韩文 → 简体中文" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════════ 翻译 ══════════════════ -->
            <TabItem Header="翻译">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Header="翻译引擎">
                            <StackPanel>
                                <RadioButton x:Name="InternalGroupRadio" GroupName="ProviderGroup" IsChecked="True"
                                             Content="内部翻译引擎（离线）" FontWeight="Bold" Margin="0,0,0,4"
                                             Checked="OnGroupSelectionChanged"/>
                                <!-- 不设固定 Height：按行内容自适应，行内模型输入框不被压扁裁剪 -->
                                <ListView x:Name="LocalProviderListView" Margin="0,0,0,4"
                                          AllowDrop="True" DragOver="OnProviderListDragOver" Drop="OnProviderListDrop"
                                          PreviewMouseLeftButtonDown="OnProviderListMouseDown"
                                          ItemTemplate="{StaticResource ProviderRowTemplate}">
                                    <!-- 列表内文本统一小一号（13）：覆盖全局 14 号的隐式 TextBlock 样式 -->
                                    <ListView.Resources>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="FontSize" Value="13"/>
                                        </Style>
                                    </ListView.Resources>
                                </ListView>
                                <RadioButton x:Name="ExternalGroupRadio" GroupName="ProviderGroup"
                                             Content="外部翻译引擎（云端 API）" FontWeight="Bold" Margin="0,8,0,4"
                                             Checked="OnGroupSelectionChanged"/>
                                <!-- 不设固定 Height：按行内容自适应，行内模型输入框不被压扁裁剪 -->
                                <ListView x:Name="ExternalProviderListView" Margin="0,0,0,6"
                                          AllowDrop="True" DragOver="OnProviderListDragOver" Drop="OnProviderListDrop"
                                          PreviewMouseLeftButtonDown="OnProviderListMouseDown"
                                          ItemTemplate="{StaticResource ProviderRowTemplate}">
                                    <!-- 列表内文本统一小一号（13）：覆盖全局 14 号的隐式 TextBlock 样式 -->
                                    <ListView.Resources>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="FontSize" Value="13"/>
                                        </Style>
                                    </ListView.Resources>
                                </ListView>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="翻译超时">
                            <StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="单次翻译超时" Style="{StaticResource RowLabel}"/>
                                    <TextBlock Text="超时" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TimeoutSecondsBox" Width="60" Margin="4,0,4,0"/>
                                    <TextBlock Text="秒后放弃本批、回落原文（整条回退链共享，默认 10）" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="质量与省流">
                            <StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <CheckBox x:Name="GlossaryEnabledCheck" Content="启用术语表" IsChecked="True" IsEnabled="False" VerticalAlignment="Center"/>
                                    <Button x:Name="EditGlossaryButton" Content="编辑术语表…" Margin="12,0,0,0" Click="OnEditGlossaryClick"/>
                                </StackPanel>
                                <CheckBox x:Name="CacheEnabledCheck" Content="启用翻译缓存" IsChecked="True" IsEnabled="False" Margin="0,4,0,4"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════════ 识别 ══════════════════ -->
            <TabItem Header="识别">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Header="识别引擎">
                            <StackPanel>
                                <TextBlock Text="PaddleOCR（韩文 mobile 模型，无需系统语言包）" Margin="0,0,0,4"/>
                                <RadioButton x:Name="OcrCpuRadio" GroupName="OcrDeviceGroup" IsChecked="True"
                                             Content="CPU（无需显卡，占内存少）" Margin="0,0,0,4"/>
                                <RadioButton x:Name="OcrGpuRadio" GroupName="OcrDeviceGroup"
                                             Content="GPU（DirectML，CPU 基本不动，免装 CUDA）" Margin="0,8,0,4"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="轮询周期（100~5000ms）">
                            <StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="场景检测" Style="{StaticResource RowLabel}"/>
                                    <TextBlock Text="每" VerticalAlignment="Center"/>
                                    <TextBox x:Name="SceneDetectPollBox" Width="60" Margin="4,0,4,0"/>
                                    <TextBlock Text="ms 识别一次（默认 200）" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="翻译" Style="{StaticResource RowLabel}"/>
                                    <TextBlock Text="每" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TranslatePollBox" Width="60" Margin="4,0,4,0"/>
                                    <TextBlock Text="ms 跑一轮 OCR+翻译（默认 500）" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════════ 区域 ══════════════════ -->
            <TabItem Header="区域" x:Name="RegionTab">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RegionHintText" Text="尚未加载" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="EnterCalibrationButton" Content="进入校准" Click="OnEnterCalibrationClick"/>
                        </Grid>
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,4,0,0"
                                   Text="ⓘ 程序已经预设了16:9、16:10、4:3三种显示比例的区域定位，覆盖了主要需要识别的区域。位置坐标采用相对坐标，即在屏幕中的百分比。"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="已定义区域（坐标为相对值 0~1 百分比）：" FontWeight="Bold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="EditRoiButton" Content="编辑选中" IsEnabled="False" Click="OnEditRoiClick"/>
                            <Button x:Name="DeleteRoiButton" Content="删除选中" Margin="8,0,0,0" IsEnabled="False" Click="OnDeleteRoiClick"/>
                        </StackPanel>
                    </Grid>
                    <ListView x:Name="RoiListView" Grid.Row="2" Margin="0,0,0,4"
                              MouseDoubleClick="OnRoiListDoubleClick" SelectionChanged="OnRoiListSelectionChanged">
                        <!-- 列表内文本统一小一号（13）：覆盖全局 14 号的隐式 TextBlock 样式 -->
                        <ListView.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="FontSize" Value="13"/>
                            </Style>
                            <!-- 行高以热键页列表为准（带按钮的行更高）：统一最小行高，两表行高一致 -->
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                <Setter Property="MinHeight" Value="36"/>
                            </Style>
                        </ListView.Resources>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="场景" Width="86" DisplayMemberBinding="{Binding Scene}"/>
                                <GridViewColumn Header="分辨率" Width="90" DisplayMemberBinding="{Binding Resolution}"/>
                                <GridViewColumn Header="名称" Width="150" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="左, 顶, 宽, 高" Width="220" DisplayMemberBinding="{Binding Rect}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>

            <!-- ══════════════════ 热键 ══════════════════ -->
            <TabItem Header="热键">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <ListView x:Name="HotkeyListView" Height="220">
                            <!-- 列表内文本统一小一号（13）：覆盖全局 14 号的隐式 TextBlock 样式 -->
                            <ListView.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="FontSize" Value="13"/>
                                </Style>
                            </ListView.Resources>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="功能" Width="220" DisplayMemberBinding="{Binding Function}"/>
                                    <GridViewColumn Header="当前热键" Width="140" DisplayMemberBinding="{Binding Current}"/>
                                    <GridViewColumn Header="操作" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="修改" Width="70" Tag="{Binding Key}" Click="OnRebindHotkeyClick"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,8,0,0"
                                   Text="ⓘ 仅允许 Ctrl / Shift / Alt + F6 ~ F9 的热键注册"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════════ 外观 ══════════════════ -->
            <TabItem Header="外观">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Header="悬浮层">
                            <StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="字体" Style="{StaticResource RowLabel}"/>
                                    <ComboBox x:Name="FontFamilyBox" Width="160" IsEditable="True">
                                        <!-- 每个 item 用对应字体渲染，方便预览效果。
                                             关键在 ContentTemplate 而非 ItemTemplate：显式 ComboBoxItem 是"容器"不是数据项，
                                             ItemTemplate 对它们不生效、会各自退回隐式 TextBlock 样式（Fluent 字体，三个 item 长得一样）。
                                             ContentTemplate 设在 item 身上，显式容器一定用它渲染 Content；里面的 TextBlock 用显式局部绑定
                                             把 FontFamily 绑回所属 ComboBoxItem 的 FontFamily（代码后端设的值），局部绑定压过样式设置器。
                                             Kostar = 内嵌原版 SC:R 字体（默认）：拉丁复刻原字体 + 谚文，无中文（中文回退系统字体） -->
                                        <ComboBox.Resources>
                                            <DataTemplate x:Key="FontPreviewTemplate">
                                                <!-- Text 必须显式绑：DataTemplate 里 TextBlock 不会自动把字符串内容当 Text 显示
                                                     （那是默认 ContentPresenter 的行为），漏了会渲染成空白 -->
                                                <TextBlock Text="{Binding}" FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"/>
                                            </DataTemplate>
                                        </ComboBox.Resources>
                                        <ComboBoxItem x:Name="FontKostar" Content="Kostar" ContentTemplate="{StaticResource FontPreviewTemplate}"/>
                                        <ComboBoxItem x:Name="FontYaHei" Content="Microsoft YaHei" ContentTemplate="{StaticResource FontPreviewTemplate}"/>
                                        <ComboBoxItem x:Name="FontArial" Content="Arial" ContentTemplate="{StaticResource FontPreviewTemplate}"/>
                                    </ComboBox>
                                    <TextBlock Text="字号" Style="{StaticResource RowLabel}" Width="50" Margin="16,0,8,0"/>
                                    <TextBox x:Name="FontSizeBox" Width="50"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="字宽" Style="{StaticResource RowLabel}"/>
                                    <Slider x:Name="WidthScaleSlider" Width="200" Minimum="0.7" Maximum="1.3" Value="1" TickFrequency="0.05" ValueChanged="OnWidthScaleChanged"/>
                                    <TextBlock x:Name="WidthScaleValueText" Text="100%" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="字体颜色" Style="{StaticResource RowLabel}"/>
                                    <!-- 调色板：点色块选色。第一格=游戏对局聊天正文绿 #13FF1D（默认，采样自 ingame-w-1.png）；
                                         其余含房间列表采样色（白 #F3F3F3）与常用色。Tag 存真实 hex，选中态用蓝框标示 -->
                                    <WrapPanel x:Name="FontColorPalette" VerticalAlignment="Center">
                                        <Border Width="22" Height="22" CornerRadius="4" Background="#13FF1D" Margin="2" Cursor="Hand" Tag="#13FF1D" MouseLeftButtonUp="OnFontColorSwatchClick" BorderBrush="#808080" BorderThickness="1"/>
                                        <Border Width="22" Height="22" CornerRadius="4" Background="#F3F3F3" Margin="2" Cursor="Hand" Tag="#F3F3F3" MouseLeftButtonUp="OnFontColorSwatchClick" BorderBrush="#808080" BorderThickness="1"/>
                                        <Border Width="22" Height="22" CornerRadius="4" Background="#FFFFFF" Margin="2" Cursor="Hand" Tag="#FFFFFF" MouseLeftButtonUp="OnFontColorSwatchClick" BorderBrush="#808080" BorderThickness="1"/>
                                        <Border Width="22" Height="22" CornerRadius="4" Background="#FFFF00" Margin="2" Cursor="Hand" Tag="#FFFF00" MouseLeftButtonUp="OnFontColorSwatchClick" BorderBrush="#808080" BorderThickness="1"/>
                                        <Border Width="22" Height="22" CornerRadius="4" Background="#00FFFF" Margin="2" Cursor="Hand" Tag="#00FFFF" MouseLeftButtonUp="OnFontColorSwatchClick" BorderBrush="#808080" BorderThickness="1"/>
                                        <Border Width="22" Height="22" CornerRadius="4" Background="#FFA500" Margin="2" Cursor="Hand" Tag="#FFA500" MouseLeftButtonUp="OnFontColorSwatchClick" BorderBrush="#808080" BorderThickness="1"/>
                                        <Border Width="22" Height="22" CornerRadius="4" Background="#FF6347" Margin="2" Cursor="Hand" Tag="#FF6347" MouseLeftButtonUp="OnFontColorSwatchClick" BorderBrush="#808080" BorderThickness="1"/>
                                        <Border Width="22" Height="22" CornerRadius="4" Background="#FF0000" Margin="2" Cursor="Hand" Tag="#FF0000" MouseLeftButtonUp="OnFontColorSwatchClick" BorderBrush="#808080" BorderThickness="1"/>
                                        <Border Width="22" Height="22" CornerRadius="4" Background="#FFB6C1" Margin="2" Cursor="Hand" Tag="#FFB6C1" MouseLeftButtonUp="OnFontColorSwatchClick" BorderBrush="#808080" BorderThickness="1"/>
                                    </WrapPanel>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="不透明度" Style="{StaticResource RowLabel}"/>
                                    <Slider x:Name="OpacitySlider" Width="200" Minimum="0" Maximum="1" ValueChanged="OnOpacityChanged"/>
                                    <TextBlock x:Name="OpacityValueText" Text="80%" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="文字底衬" Style="{StaticResource RowLabel}"/>
                                    <Slider x:Name="BackplateSlider" Width="200" Minimum="0" Maximum="1" ValueChanged="OnBackplateChanged"/>
                                    <TextBlock x:Name="BackplateValueText" Text="80%" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════════ 日志 ══════════════════ -->
            <TabItem Header="日志">
                <DockPanel Margin="8">
                    <Button DockPanel.Dock="Top" x:Name="ExportLogButton" Content="导出日志" HorizontalAlignment="Right" Width="80" Margin="0,0,0,6" Click="OnExportLogClick"/>
                    <ListBox x:Name="LogListBox" FontFamily="Consolas, Cascadia Mono, Microsoft YaHei" FontSize="12"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </DockPanel>
            </TabItem>

            <!-- ══════════════════ 关于 ══════════════════ -->
            <TabItem Header="关于">
                <DockPanel Margin="12">
                    <!-- DEBUG 模式开关（从常规页移来，放右上角） -->
                    <CheckBox x:Name="DebugModeCheck" DockPanel.Dock="Top" HorizontalAlignment="Right" Content="DEBUG模式" Margin="0,0,0,8" Checked="OnDebugModeToggle" Unchecked="OnDebugModeToggle"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="VersionText" Text="版本 —" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                            <TextBlock Margin="0,0,0,16" LineHeight="24" TextWrapping="Wrap"><Run Text="本项目已开源（MIT License）："/><Hyperlink NavigateUri="https://github.com/cfj521/starcraft_translator" RequestNavigate="OnRepoLinkNavigate">https://github.com/cfj521/starcraft_translator</Hyperlink></TextBlock>
                        <TextBlock Text="第三方组件：" FontWeight="Bold" Margin="0,10,0,6"/>
                        <TextBlock TextWrapping="Wrap" LineHeight="24" Margin="0,0,0,6"
                                   Text="H.NotifyIcon.Wpf（系统托盘）、RapidOcrNet + PaddleOCR 韩文 mobile 模型（OCR）、SkiaSharp（图像处理）、Microsoft.Extensions.Hosting（DI 组合根）、System.Security.Cryptography.ProtectedData（DPAPI）、CsWinRT / Windows.Graphics.Capture（屏幕捕获）。"/>
                        <TextBlock Text="密钥保护：" FontWeight="Bold" Margin="0,16,0,6"/>
                        <TextBlock TextWrapping="Wrap" LineHeight="24" Margin="0,0,0,6"
                                   Text="机翻 / LLM 的密钥只在你直连对应服务商 API 时使用，程序不会把它们转发给任何第三方，也不留存任何记录——不写日志、不上传云端、不进代码仓库。"/>
                        <TextBlock Text="使用须知：" FontWeight="Bold" Margin="0,16,0,6"/>
                        <TextBlock TextWrapping="Wrap" LineHeight="24"
