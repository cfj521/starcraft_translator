<Window x:Class="ScrTranslator.App.Config.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SC:R Translator — 配置"
        Width="820" Height="600"
        MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="RowLabel">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Width" Value="120"/>
        </Style>
        <Style TargetType="StackPanel" x:Key="Row">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="ApplyButton" Content="应用" Width="80" Margin="0,0,8,0" Click="OnApplyClick"/>
            <Button x:Name="OkButton" Content="确定" Width="80" Margin="0,0,8,0" Click="OnOkClick" IsDefault="True"/>
            <Button x:Name="CancelButton" Content="取消" Width="80" Click="OnCancelClick" IsCancel="True"/>
        </StackPanel>

        <TabControl TabStripPlacement="Left">

            <!-- ══════════════════ 常规 ══════════════════ -->
            <TabItem Header="常规">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Header="游戏窗口">
                            <StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="目标进程" Style="{StaticResource RowLabel}"/>
                                    <TextBox x:Name="TargetProcessBox" Width="180"/>
                                    <Button x:Name="RedetectButton" Content="重新检测" Margin="8,0,0,0" Click="OnRedetectClick"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="当前状态" Style="{StaticResource RowLabel}"/>
                                    <TextBlock x:Name="StatusText" Text="○ 未检测" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="⚠ 提示：请以“窗口化/无边框”模式运行游戏，独占全屏无法悬浮。"
                                           Foreground="DarkOrange" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="启动">
                            <StackPanel>
                                <CheckBox x:Name="AutoStartCheck" Content="开机自启（仅存开关，注册表接线留待打包阶段）（后续生效）" Margin="0,2,0,2"/>
                                <CheckBox x:Name="StartMinimizedCheck" Content="启动后最小化到托盘（后续生效）" Margin="0,2,0,2"/>
                                <CheckBox x:Name="AutoTranslateCheck" Content="启动游戏时自动开启翻译（后续生效）" Margin="0,2,0,2"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="语言">
                            <StackPanel>
                                <TextBlock Text="界面语言：简体中文（固定）" Margin="0,2,0,2"/>
                                <TextBlock Text="源语言 → 目标：韩文 → 简体中文（固定）" Margin="0,2,0,2"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════════ 翻译 ══════════════════ -->
            <TabItem Header="翻译">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Header="引擎">
                            <StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="主引擎" Style="{StaticResource RowLabel}"/>
                                    <RadioButton x:Name="DashScopeEngineRadio" GroupName="Engine" Content="DashScope（阿里云）" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                    <RadioButton x:Name="ChatGptEngineRadio" GroupName="Engine" Content="ChatGPT（订阅）" VerticalAlignment="Center"/>
                                </StackPanel>
                                <CheckBox x:Name="TwoLevelCheck" Content="两级翻译（快译临时 → 精译定稿原地替换）" Margin="0,4,0,4"/>
                                <StackPanel Style="{StaticResource Row}">
                                    <Button x:Name="DashScopeKeyButton" Content="设置阿里云 Key…" Width="140" Click="OnSetDashScopeKeyClick"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <Button x:Name="ChatGptLoginButton" Content="登录 ChatGPT…" Width="140" Click="OnLoginChatGptClick"/>
                                    <TextBlock x:Name="ChatGptStatusText" Text="未登录" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="DashScope 模型" Style="{StaticResource RowLabel}"/>
                                    <TextBox x:Name="DashScopeModelBox" Width="180"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="ChatGPT 模型" Style="{StaticResource RowLabel}"/>
                                    <TextBox x:Name="ChatGptModelBox" Width="180"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="快引擎模型(两级用)" Style="{StaticResource RowLabel}"/>
                                    <TextBox x:Name="FastModelBox" Width="180"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="内容范围">
                            <StackPanel>
                                <CheckBox x:Name="TranslateChatCheck" Content="翻译聊天" Margin="0,2,0,2"/>
                                <CheckBox x:Name="TranslateRoomNameCheck" Content="翻译房间名" Margin="0,2,0,2"/>
                                <CheckBox x:Name="TranslateMapInfoCheck" Content="翻译地图信息" Margin="0,2,0,2"/>
                                <CheckBox x:Name="TranslatePlayerIdCheck" Content="翻译玩家 ID（默认关，F7）" Margin="0,2,0,2"/>
                                <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,4,0,0"
                                           Text="ⓘ 玩家 ID 多为专有名词，通常不翻译。开启后房间列表的 ID 列也会被翻译。可用热键 F7 随时切换。"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="质量与省流">
                            <StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <CheckBox x:Name="GlossaryEnabledCheck" Content="启用术语表（星际黑话，始终生效）" IsChecked="True" IsEnabled="False" VerticalAlignment="Center"/>
                                    <Button x:Name="EditGlossaryButton" Content="编辑术语表…" Margin="12,0,0,0" Click="OnEditGlossaryClick"/>
                                </StackPanel>
                                <CheckBox x:Name="CacheEnabledCheck" Content="启用翻译缓存（进程内 LRU，容量固定，无 TTL）" IsChecked="True" IsEnabled="False" Margin="0,4,0,4"/>
                                <CheckBox Content="LLM 节流（防刷屏）— 后续" IsEnabled="False" Margin="0,4,0,4"/>
                                <CheckBox Content="保留上下文供 LLM 参考 — 后续" IsEnabled="False" Margin="0,4,0,4"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════════ OCR ══════════════════ -->
            <TabItem Header="OCR">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Header="识别引擎">
                            <TextBlock Text="PaddleOCR（韩文 mobile 模型，随包分发，无需系统语言包）" Margin="4"/>
                        </GroupBox>
                        <GroupBox Header="轮询频率（后续生效）">
                            <StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="聊天区" Style="{StaticResource RowLabel}"/>
                                    <TextBlock Text="每" VerticalAlignment="Center"/>
                                    <TextBox x:Name="ChatPollBox" Width="60" Margin="4,0,4,0"/>
                                    <TextBlock Text="ms 检测一次" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="其它区域" Style="{StaticResource RowLabel}"/>
                                    <TextBlock Text="每" VerticalAlignment="Center"/>
                                    <TextBox x:Name="OtherPollBox" Width="60" Margin="4,0,4,0"/>
                                    <TextBlock Text="ms 检测一次" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="图像预处理（后续生效）">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="UpscaleCheck" Content="放大" Margin="0,0,16,0"/>
                                <CheckBox x:Name="GrayscaleCheck" Content="灰度" Margin="0,0,16,0"/>
                                <CheckBox x:Name="BinarizeCheck" Content="二值化"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="变化检测灵敏度（0=最不敏感，10=最敏感）（后续生效）">
                            <StackPanel Orientation="Horizontal">
                                <Slider x:Name="SensitivitySlider" Width="240" Minimum="0" Maximum="10"
                                        TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnSensitivityChanged"/>
                                <TextBlock x:Name="SensitivityValueText" Text="5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════════ 区域 ══════════════════ -->
            <TabItem Header="区域">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock x:Name="RegionHintText" Text="尚未加载" VerticalAlignment="Center"/>
                            <Button x:Name="EnterCalibrationButton" Content="进入校准…" Margin="16,0,0,0" Click="OnEnterCalibrationClick"/>
                        </StackPanel>
                        <TextBlock Text="已定义区域：" FontWeight="Bold" Margin="0,0,0,4"/>
                        <ListView x:Name="RoiListView" Height="160" Margin="0,0,0,10">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="名称" Width="180" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="类型" Width="100" DisplayMemberBinding="{Binding Type}"/>
                                    <GridViewColumn Header="位置(相对)" Width="220" DisplayMemberBinding="{Binding Position}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock Text="RoomList 列定义（只读，进入校准可编辑）：" FontWeight="Bold" Margin="0,0,0,4"/>
                        <ListView x:Name="ColumnsListView" Height="140">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="所属区域" Width="180" DisplayMemberBinding="{Binding RoiName}"/>
                                    <GridViewColumn Header="列范围" Width="120" DisplayMemberBinding="{Binding Range}"/>
                                    <GridViewColumn Header="语义" Width="100" DisplayMemberBinding="{Binding Kind}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,8,0,0"
                                   Text="ⓘ “ID 列是否翻译”由「翻译」页的「翻译玩家 ID」开关联动决定，不在此单独配置。"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════════ 热键 ══════════════════ -->
            <TabItem Header="热键">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <ListView x:Name="HotkeyListView" Height="220">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="功能" Width="220" DisplayMemberBinding="{Binding Function}"/>
                                    <GridViewColumn Header="当前热键" Width="140" DisplayMemberBinding="{Binding Current}"/>
                                    <GridViewColumn Header="操作" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="修改" Width="70" Tag="{Binding Key}" Click="OnRebindHotkeyClick"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <Button x:Name="ResetHotkeysButton" Content="恢复默认热键" Width="120" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnResetHotkeysClick"/>
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,8,0,0"
                                   Text="点「修改」后按下新组合键即可录制（Esc 取消）；冲突会提示并放弃，成功则立即生效并保存。"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════════ 外观 ══════════════════ -->
            <TabItem Header="外观">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Header="悬浮层">
                            <StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="字体（后续生效）" Style="{StaticResource RowLabel}"/>
                                    <ComboBox x:Name="FontFamilyBox" Width="160" IsEditable="True">
                                        <ComboBoxItem Content="Microsoft YaHei"/>
                                        <ComboBoxItem Content="Microsoft YaHei UI"/>
                                        <ComboBoxItem Content="SimHei"/>
                                        <ComboBoxItem Content="SimSun"/>
                                    </ComboBox>
                                    <TextBlock Text="字号" Style="{StaticResource RowLabel}" Width="50" Margin="16,0,8,0"/>
                                    <TextBox x:Name="FontSizeBox" Width="50"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="不透明度" Style="{StaticResource RowLabel}"/>
                                    <Slider x:Name="OpacitySlider" Width="200" Minimum="0" Maximum="1" ValueChanged="OnOpacityChanged"/>
                                    <TextBlock x:Name="OpacityValueText" Text="80%" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="显示模式" Style="{StaticResource RowLabel}"/>
                                    <RadioButton x:Name="OnlyTranslationRadio" GroupName="DisplayMode" Content="仅译文" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                    <RadioButton x:Name="BothRadio" GroupName="DisplayMode" Content="原文+译文双行（后续生效）" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="临时态(快引擎)样式" Style="{StaticResource RowLabel}" Width="140"/>
                                    <TextBlock Text="灰色/半斜体 0.65 透明（只读，改色留后续）" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="最终态(精译)样式" Style="{StaticResource RowLabel}" Width="140"/>
                                    <TextBlock Text="正常白色（只读）" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════════ 关于 ══════════════════ -->
            <TabItem Header="关于">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock x:Name="VersionText" Text="版本 —" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                        <TextBlock Text="许可：内部项目，未开源" Margin="0,0,0,8"/>
                        <TextBlock Text="第三方组件：" FontWeight="Bold" Margin="0,8,0,4"/>
                        <TextBlock TextWrapping="Wrap"
                                   Text="H.NotifyIcon.Wpf（系统托盘）、RapidOcrNet + PaddleOCR 韩文 mobile 模型（OCR）、SkiaSharp（图像处理）、Microsoft.Extensions.Hosting（DI 组合根）、System.Security.Cryptography.ProtectedData（DPAPI）、CsWinRT / Windows.Graphics.Capture（屏幕捕获）。"/>
                        <TextBlock Text="使用须知：" FontWeight="Bold" Margin="0,12,0,4"/>
                        <TextBlock TextWrapping="Wrap"
                                   Text="• 请以「窗口化/无边框」模式运行《星际争霸：重制版》，独占全屏会遮挡悬浮窗，悬浮窗也不可交互（点击穿透）。&#10;• 本软件纯读屏：仅截取屏幕画面做 OCR 识别 + 翻译显示，不注入游戏进程、不修改游戏文件、不读取游戏内存。&#10;• 任何第三方叠加层工具理论上都存在被反作弊/官方规则误判的风险，请自行评估后使用；作者不对因使用本软件导致的任何账号处罚负责。"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
